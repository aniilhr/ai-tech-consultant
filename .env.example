# Copy to .env and fill in. Every service reads this one file (or real environment variables).
# Never commit .env.

# ---------------------------------------------------------------------------
# LLM provider
# ---------------------------------------------------------------------------
# auto = gemini if GEMINI_API_KEY is set, else anthropic if ANTHROPIC_API_KEY is set, else offline.
# offline = no model calls; deterministic fallbacks, clearly labelled "offline" in the UI and API.
LLM_PROVIDER=auto

GEMINI_API_KEY=
# Fast tier: classification, capability checks. Smart tier: answers, drafts, extraction, proposals.
GEMINI_MODEL_FAST=gemini-3.5-flash-lite
GEMINI_MODEL_SMART=gemini-3.8-flash
GEMINI_MODEL_VISION=gemini-3.8-flash
# gemini-embedding-001 (taskType API) or gemini-embedding-2 (task-prefix API) are both supported.
GEMINI_EMBED_MODEL=gemini-embedding-001
GEMINI_EMBED_DIM=768

# Optional second provider, used for model comparison evals (LLM_PROVIDER=anthropic).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL_FAST=claude-haiku-5-5
ANTHROPIC_MODEL_SMART=claude-sonnet-5-5

# Optional: USD per 1M tokens, used for cost tracking in logs and evals. Copy current list prices
# from the provider pricing pages. Format: {"model-name": [input_price, output_price]}
MODEL_PRICES_JSON={}

# ---------------------------------------------------------------------------
# Service URLs (defaults work for local one-command startup)
# ---------------------------------------------------------------------------
BRAIN_URL=http://127.0.0.1:8001
INBOX_URL=http://127.0.0.1:8002
SCOPE_URL=http://127.0.0.1:8003
# Public port of the web app / gateway (most hosts set PORT for you)
PORT=8080

# Where SQLite databases live. Mount a persistent disk here in production.
DATA_DIR=./data

# ---------------------------------------------------------------------------
# Task 1 - Knowledge Brain ingestion
# ---------------------------------------------------------------------------
SITEMAP_URL=https://support.brilliantdirectories.com/support/sitemap.xml
CRAWL_URL_PATTERN=/support/solutions/articles/
CRAWL_CONCURRENCY=2
CRAWL_DELAY_SECONDS=1.0
CRAWL_MAX_RETRIES=3
MAX_IMAGES_PER_ARTICLE=4
# Daily incremental sync inside the Brain process (UTC hour). Off by default.
DAILY_SYNC_ENABLED=false
DAILY_SYNC_HOUR_UTC=3
DAILY_SYNC_BATCH_LIMIT=0
# Optional shared secret for write/admin endpoints (sync, escalation answers). Empty = open (local dev).
BRAIN_ADMIN_TOKEN=

# ---------------------------------------------------------------------------
# Task 2 - Inbox Agent
# ---------------------------------------------------------------------------
COMPANY_NAME="Brilliant Directories"
SUPPORT_SIGNATURE="The Brilliant Directories Support Team"
# Automatic sending stays OFF unless you deliberately turn it on. Even when on, refunds,
# billing disputes, legal, security and quote emails are never sent automatically.
AUTO_SEND_ENABLED=false
AUTO_SEND_STREAK_REQUIRED=20

# ---------------------------------------------------------------------------
# Task 3 - Scope Builder
# ---------------------------------------------------------------------------
# Optional indicative rate. Proposals always label pricing as "not commercially approved".
INDICATIVE_HOURLY_RATE=
